# Copia este archivo como .env y completa OMLX_API_KEY (nunca subas .env a GitHub)
OMLX_API_KEY=
OMLX_URL=http://127.0.0.1:8000
PORT=5194
# Página de gestión de contactos (solo desde este Mac; 0 = desactivada)
ADMIN_PORT=5195
# Orígenes (páginas) que pueden usar el asistente, separados por comas
ALLOWED_ORIGINS=https://web-vercel-zeta-red.vercel.app,http://localhost:5190
# Dirección pública de la web (publicar.sh espera a que Vercel muestre la nueva dirección del túnel)
SITIO_URL=https://web-vercel-zeta-red.vercel.app
MAX_TOKENS=1024
MAX_CONCURRENT=2
RATE_PER_MIN=20
CONTACTOS_PER_MIN=5
